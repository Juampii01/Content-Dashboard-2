# Copia este archivo como .env.local y completa los valores. Nunca subas .env.local al repo.

# ─── Base (obligatorias) ───────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Nombre que ve el cliente en la app (por ejemplo, el nombre de su marca)
NEXT_PUBLIC_APP_NAME=Content Studio
# Zona horaria de la marca (IANA). Define los días de los gráficos y el mapa de horarios.
APP_TIMEZONE=America/Mexico_City

# Base de datos: Neon desde el Marketplace de Vercel (Storage → Create Database → Neon).
# La integración crea las dos variables solas en el proyecto de Vercel. Para desarrollo:
#   vercel env pull .env.local
# DATABASE_URL: con pooler, para la app. DATABASE_URL_UNPOOLED: directa, para migraciones y worker.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Firma de sesiones. Genérala con: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Cifrado de tokens y claves. Genérala con: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# Protege las tareas programadas. Genérala con: openssl rand -hex 32
CRON_SECRET=

# Dueño de la instalación: en el primer deploy de producción se crea y se le manda la invitación.
OWNER_EMAIL=
OWNER_NAME=

# Correos (invitaciones y recuperación de contraseña). En desarrollo, sin estas variables,
# el enlace aparece en la consola del servidor.
RESEND_API_KEY=
EMAIL_FROM="Content Studio <hola@tudominio.com>"

# Archivos: Vercel Blob (Storage → Create → Blob). La integración crea esta variable.
# Store PÚBLICO: solo copias de miniaturas de las redes.
BLOB_READ_WRITE_TOKEN=
# Store PRIVADO para videos (Editor y Videos con clon). Créalo como privado y conéctalo con el prefijo VIDEO_BLOB.
# Sin esta variable, en desarrollo los videos se guardan en .data/ y en producción el Editor queda desactivado.
VIDEO_BLOB_READ_WRITE_TOKEN=

# ─── Integraciones (se piden cuando se usa cada módulo) ────────────────────
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# IA (guiones y perfil de marca). Sin esta clave esas funciones muestran un aviso.
ANTHROPIC_API_KEY=
GROQ_API_KEY=

# ─── Editor de video: worker en Fly.io (ver docs/worker.md) ─────────────────
# Secreto compartido entre la app y el worker. Genéralo con: openssl rand -base64 32
WORKER_SECRET=
# Opcionales: con esto la app enciende la máquina del worker al encolar un video.
FLY_API_TOKEN=
FLY_WORKER_APP=
FLY_WORKER_MACHINE_ID=
# Opcional: b-roll de stock de Pexels (clave gratuita en https://www.pexels.com/api/). Sin ella, el b-roll sale
# solo de la biblioteca del cliente. Solo para pruebas con el simulador local: PEXELS_API_BASE=http://localhost:4105
PEXELS_API_KEY=

# ─── Videos con clon ─────────────────────────────────────────────────────────
# La API key de HeyGen la pega el dueño en Ajustes (se guarda cifrada en la base), no va acá.
# Solo para pruebas con el simulador local: HEYGEN_API_BASE=http://localhost:4010
APIFY_API_TOKEN=
SCRAPECREATORS_API_KEY=

# ─── Páginas legales (públicas: /privacidad, /terminos, /eliminar-datos) ───
LEGAL_COMPANY_NAME="KAVAR LLC"
LEGAL_CONTACT_EMAIL=
