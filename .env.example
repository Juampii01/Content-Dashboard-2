# Copia este archivo como .env.local y completa los valores. Nunca subas .env.local al repo.

# ─── Base (obligatorias) ───────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Nombre que ve el cliente en la app (por ejemplo, el nombre de su marca)
NEXT_PUBLIC_APP_NAME=Content Studio

# Supabase: Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Supabase: Project Settings → Database
# DATABASE_URL: pooler en modo transacción (puerto 6543), para la app
DATABASE_URL=
# DIRECT_URL: conexión directa (puerto 5432), para migraciones
DIRECT_URL=

# Cifrado de tokens y claves. Genérala con: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# Protege las tareas programadas. Genérala con: openssl rand -hex 32
CRON_SECRET=

# ─── Integraciones (se piden cuando se usa cada módulo) ────────────────────
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
APIFY_API_TOKEN=
SCRAPECREATORS_API_KEY=
